<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:text="zclaw"
            android:textColor="#2dd4bf"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/engine_picker_title"
            android:textColor="#e2e8f0"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/engine_picker_subtitle"
            android:textColor="#94a3b8"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/engineCardCodex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/engine_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/mono_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="#38bdf8"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/engine_codex"
                        android:textColor="#e2e8f0"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/engine_codex_desc"
                        android:textColor="#94a3b8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/engineCodexStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_soon"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/engine_status_stopped"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/engineCodexStart"
                    android:layout_width="108dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_secondary_bg"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/engine_btn_start"
                    android:textColor="#cbd5e1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/engineCodexOpen"
                    android:layout_width="108dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_open_selector"
                    android:enabled="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/engine_btn_open"
                    android:textColor="#e2e8f0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/engineCardOpenCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/engine_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/mono_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="O"
                    android:textColor="#a78bfa"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/engine_opencode"
                        android:textColor="#e2e8f0"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/engine_opencode_desc"
                        android:textColor="#94a3b8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/engineOpenCodeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_soon"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/engine_status_stopped"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/engineOpenCodeStart"
                    android:layout_width="108dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_secondary_bg"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/engine_btn_start"
                    android:textColor="#cbd5e1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/engineOpenCodeOpen"
                    android:layout_width="108dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_open_selector"
                    android:enabled="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/engine_btn_open"
                    android:textColor="#e2e8f0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/engineCardOpenClaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/engine_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/mono_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="K"
                    android:textColor="#fbbf24"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/engine_openclaw"
                        android:textColor="#e2e8f0"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/engine_openclaw_desc"
                        android:textColor="#94a3b8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/engineOpenClawStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_soon"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/engine_status_soon"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:text="@string/engine_picker_footer"
            android:textColor="#64748b"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>